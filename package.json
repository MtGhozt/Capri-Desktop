{
  "name": "capri-desktop",
  "version": "0.1.1",
  "description": "Capri, the Project Capricorn construct, living on your desktop. Free forever.",
  "author": "Capri Desktop contributors",
  "repository": "github:MtGhozt/Capri-Desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "demo:art": "node scripts/demo-art.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "dist": "electron-builder --win",
    "test": "node --test test/*.test.js --test-force-exit",
    "test:e2e": "node --test test/e2e/smoke.e2e.js --test-force-exit --test-timeout=180000"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "copyright": "Copyright Capri Desktop contributors",
    "files": [
      "src/**/*",
      "assets/**/*",
      "hooks/**/*",
      "package.json",
      "LICENSE",
      "CREDITS.md",
      "!voice/**",
      "!**/*.wav",
      "!**/ref/**",
      "!scripts/**",
      "scripts/install-hooks.js",
      "scripts/demo-sequence.js"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1",
      "src/main/focus.ps1",
      "src/main/hotkey.ps1",
      "src/main/close-app.ps1",
      "src/main/media-keys.ps1",
      "src/main/session-volume.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    }
  }
}

